// the calibration kernel's push constants
struct CalibratePush
{
    uint iterations;   // hash rounds per element
};

// RT shadows' filter (rt/shadow_filter.slang) push constants
struct ShadowFilterPush
{
    uint4 extent;   // x width, y height, z lights, w history frames (0: none)
    uint4 seed;   // x render seed, y frame index since the last temporal reset: the output's dither
};

// one light as RT GI's bounce sees it (a storage buffer of every raster light but flashes), attenuated as the lighting pass attenuates it
struct GILight
{
    float4 positionAndType;   // xyz position (a rect: its centre); w type: 0 directional, 1 point, 2 spot
    float4 directionAndRange;   // xyz the unit direction the light travels (directional, spot); w the range
    float4 radiance;   // xyz colour times intensity; w this light's share of the lights' power (its probability when candidates are drawn)
    float4 cone;   // x a spot's inner-cone cosine, y its outer-cone cosine; z, w the alias table's entry for this slot: the probability of keeping it, and the alias (a uint's bits)
};

// RT GI's trace (rt/gi_trace.slang) push constants
struct GITracePush
{
    uint4 extent;   // x, y the trace's size (realtime: half the frame's, rounded up, or the frame's at full resolution); z, w the frame's
    uint4 seed;   // x render seed, y frame index since the last temporal reset, z rays a pixel, w lights
    uint4 flags;   // x quality (0 realtime, 1 reference), y 1 when an environment map is bound, 2 when RT direct light lights emissive surfaces (a hit's emission is then not brought back), z reference: the frames already in the running mean (0: start it again), w realtime: the trace is the frame >> w (1 half resolution, 0 full; render.settings rtGI.resolution)
    float4 cameraPos;   // xyz the camera's position (the denoiser's depth guide is the distance from it); w the environment's intensity (Environment.intensity: a miss brings back the environment times it)
};

// SSS (postprocess/sss.slang) push constants, both entries
struct SSSPush
{
    uint4 extent;   // x, y the frame's size; z, w its tiles across and down
    float4 params;   // x unused (the step is each pixel's, from its free path, at most 10); y a pixel's world size at unit distance (2 tan(fov/2) / height)
    float4 cameraPos;   // xyz the camera's position: the depth weight compares distances from it
};

// RT GI's denoiser (rt/gi_denoise.slang) push constants
struct GIDenoisePush
{
    uint4 extent;   // x, y the half-resolution size; z, w the frame's
    uint4 params;   // x history frames (0: none), y the a-trous step in pixels, z the trace is the frame >> z (1 half resolution, 0 full)
    float4 cameraPos;   // xyz the camera's position (the upsample's depth guide)
};

// ReSTIR DI (rt/restir_di.slang) and its denoiser (rt/di_denoise.slang) push constants
struct DIPush
{
    uint4 extent;   // x width, y height, z frame index since the last temporal reset, w render seed
    uint4 params;   // x candidates a pixel, y spatial neighbours, z flags (1 reference, 2 last frame's reservoirs and history valid), w reference: the frames already in the running mean; the denoiser: the a-trous step in pixels
    float4 cameraPos;   // xyz the camera's position (the guides' distance is from it)
    float4 weather;   // x wetness, y snow cover, z frost cover: the lighting pass's, so the target is the material it shades
    uint4 trace;   // x, y the resampling images' size (the frame's >> z), z the shift: 0 full resolution, 1 half (a pixel of each 2x2 block resamples and traces; di.shade shades every pixel from its 4 nearest)
};

// one meshlet of the meshlet arena (render/scene/meshlet_builder): at most kMeshletMaxVertices vertices and kMeshletMaxTriangles triangles of one submesh
struct MeshletGpu
{
    uint4 range;   // x its first entry in the meshlet-vertex arena, y its first in the meshlet-triangle arena, z its vertex count, w its triangle count
    float4 sphere;   // xyz the bounding sphere's centre (mesh space), w its radius
    float4 cone;   // xyz the normal cone's unit axis (mesh space), w its cutoff: back-facing from a camera at c when dot(centre - c, axis) >= cutoff * |centre - c| + radius; 1: never
};

// one draw of RenderScene's draw table (an instance's submesh), read by GPU culling and by the G-buffer and CSM vertex shaders through firstInstance
struct DrawRecord
{
    uint4 draw;   // x first index, y index count, z vertex offset (an int's bits), w the instance-table slot
    uint4 info;   // x the material slot, y flags (kDrawOneSided, kDrawEmitter, kDrawViewModel, kDrawSkinned), z the submesh's first meshlet, w its meshlet count
    float4 aabbMin;   // xyz the mesh's local bounding box, minimum; w the draw's first meshlet entry (a uint's bits: the meshlets of the draws before it)
    float4 aabbMax;   // xyz the mesh's local bounding box, maximum
};

// GPU culling (cull/instances.slang) push constants, every entry
struct CullPush
{
    column_major float4x4 viewProj;   // the view-projection the draws are rasterized with (jitter included)
    uint4 config;   // x the items culled (draws, or meshlet entries), y phase (kCullPhase*), z flags (kCullFrustum, kCullOcclusion, kCullCone), w the draw count
    uint4 hiz;   // x, y the frame's size in pixels; z the Hi-Z pyramid's levels; w the scan's block count
    float4 camera;   // xyz the camera's world position (the cone test)
    uint4 extra;   // x the first list written (its count word), y the lists written (1, 2 or 4), z the geometry mode (kGeometry*)
};

// the G-buffer's meshlet shaders (cull/meshlets.slang: task, mesh, pull) push constants, at offset 16 (gbuffer.slang's block first)
struct MeshletPush
{
    uint4 config;   // x the drawn list's first command (uints into the culling commands), y flags (kCullFrustum, kCullOcclusion, kCullCone), z the Hi-Z pyramid's levels
    uint4 hiz;   // x, y the frame's size in pixels
    float4 camera;   // xyz the camera's world position
};

// the Hi-Z build (cull/hiz.slang) push constants
struct HiZPush
{
    uint4 size;   // x, y the level written; z, w the level (or depth buffer) read
};

// one raster light of the light table (core/deferred_lighting.slang, compute/light_cluster.slang)
struct LightGpu
{
    float4 position;   // xyz position (world; a rectangle's centre), w type: 0 directional, 1 point, 2 spot, 3 rectangle (area light)
    float4 direction;   // xyz direction (a rectangle's first edge), w range: point and spot light contributes nothing past it (a rectangle has none)
    float4 color;   // xyz colour, w intensity (a rectangle's radiance, I / (4 pi r^2))
    float4 params;   // x cos inner cone, y cos outer cone, z the sphere radius of a point or spot light with an emitter mesh (its specular is that sphere's reflection; 0 a point); a rectangle's xyz is its second edge; w 1 casts shadows, 0 casts none, -1 a flash (RT direct light lights every light but flashes)
};

// lights.cluster (compute/light_cluster.slang) push constants
struct ClusterPush
{
    column_major float4x4 view;   // the view matrix the lighting pass picks froxels with
    float4 proj;   // the projection the G-buffer was rasterized with (jitter included): x proj[0][0], y proj[1][1], z proj[2][0], w proj[2][1]
    float4 screen;   // x, y the frame's size in pixels; z the slice scale (kClusterSlices / log(far / kClusterNear)); w the slice bias (-log(kClusterNear) * scale): slice = floor(log(distance) * z + w)
    uint4 config;   // x the light count
};

// skin and skin.bounds (skin/skin.slang) push constants, one skinned instance a dispatch
struct SkinPush
{
    uint4 mesh;   // x the base (bind-pose) mesh's first vertex in the arena, y the instance's own mesh's first vertex, z the vertex count
    uint4 palette;   // x this frame's palette's first matrix in the slot's palette buffer, y last frame's, z the bone count
    uint4 meshlets;   // skin.bounds: x the instance's first meshlet (its own copies), y its meshlet count
};

// capture.preview (capture/preview.slang) push constants
struct PreviewPush
{
    uint4 src;   // the source rectangle of the final image: x, y its origin, z, w its size
    uint4 dst;   // x, y the preview's size (each at most the source's)
};

// one emitter of the effect set (vfx::EmitterDesc), the closed form's parameters (vfx/particle_math.hpp)
struct VfxEmitterGpu
{
    float4 lifeSpeed;   // x, y life range (s); z, w speed range (m/s)
    float4 shape;   // x size at birth, y size at death (m); z the cone's half angle (deg); w gravity (m/s^2 along -Y)
    float4 motion;   // x drag (1/s); y offset along the record's -Z (m); z intensity (HDR multiplier); w soft fade distance (m, 0 hard)
    uint4 look;   // x blend (kVfxBlend*), y 1 lit, z texture (bindless index, kVfxNoTexture), w frame mode (0 life, 1 random, 2 fixed) | fixed frame << 8
    uint4 atlas;   // x columns, y rows of the flipbook; z colour keys, w alpha keys (1..kVfxCurveKeys)
    float4 color0;   // colour key 0: x t (0..1 of life), yzw linear rgb
    float4 color1;   // colour key 1
    float4 color2;   // colour key 2
    float4 color3;   // colour key 3
    float4 alphaT;   // the alpha keys' times
    float4 alphaV;   // the alpha keys' values
};

// one emitter of one effect record this frame: its particles are a range of the expansion buffer
struct VfxBatchGpu
{
    column_major float4x4 pose;   // the record's world pose (origin; particles thrown along -Z)
    uint4 info;   // x the emitter (VfxEmitterGpu index), y the record's seed, z the first particle slot, w the particle count
    float4 timing;   // x the record's age (s): (step - spawnStep - 1 + alpha) * dt
};

// one particle as vfx.expand evaluated it this frame
struct VfxParticleGpu
{
    float4 posSize;   // xyz world position, w size (m; 0 dead)
    float4 color;   // rgb lit colour times intensity (linear HDR), a alpha
    uint4 info;   // x flipbook frame, y the batch, z sort key (the view distance's float bits), w 1 alive
    float4 light;   // rgb the light it received (tests read it: lit particles only), w unused
};

// vfx.expand (vfx/expand.slang) push constants (128 bytes: the guaranteed push constant size)
struct VfxExpandPush
{
    column_major float4x4 viewProj;   // the jittered view-projection (screen positions for the froxel and RT GI lookups)
    float4 viewZ;   // the view matrix's third row: a point's view depth is -(dot(viewZ.xyz, p) + viewZ.w) (the froxel's slice)
    float4 camera;   // xyz the camera's position; w the environment's intensity (flag 4)
    float4 screen;   // x, y the frame's size; z, w the froxel slice scale and bias (ClusterPush.screen.zw)
    uint4 config;   // x particle slots, y batches, z lights (without clusters), w flags: 1 clustered, 2 RT GI, 4 environment, 8 TLAS (sun shadow ray)
};

// vfx.sort (vfx/sort.slang) push constants, one workgroup a batch
struct VfxSortPush
{
    uint4 range;   // x the batch's first particle slot, y its count (<= kVfxSortMax)
};

// the transparent pass's particle shaders (vfx/particle.slang) push constants
struct VfxDrawPush
{
    column_major float4x4 viewProj;   // the jittered view-projection the G-buffer was drawn with
    float4 right;   // xyz the camera's right axis; w the projection's depth A (proj[2][2])
    float4 up;   // xyz the camera's up axis; w the projection's depth B (proj[3][2]): view depth = B / (depth + A)
    uint4 range;   // x the batch's first particle slot, y the emitter, z 1 sorted
    float4 screen;   // x, y the frame's size; z the camera's near plane
};

// one decal record this frame (vfx::DecalDesc at a record's pose): a unit cube of decal space, [-0.5, 0.5]^3, scaled by its size and depth (decalToWorld carries the scale)
struct DecalGpu
{
    column_major float4x4 decalToWorld;   // decal space to world: the record's pose scaled (size, size, depth); its -Z is the surface's normal, out of the surface
    column_major float4x4 worldToDecal;   // its inverse
    float4 tint;   // xyz the albedo tint (linear); w the fade (the last tenth of the decal's life: 0..1)
    float4 params;   // x roughness; y the normal map's strength; z, w unused
    uint4 textures;   // x the albedo texture (bindless index, kVfxNoTexture: none); y the normal map (kVfxNoTexture: none)
};

// decal pass (vfx/decal.slang) push constants (96 bytes)
struct DecalPush
{
    column_major float4x4 viewProj;   // the jittered view-projection the G-buffer was drawn with
    float4 camera;   // xyz the eye; w unused
    float4 screen;   // x, y the frame's size; z the eye clearance in m (no decal nearer the eye: the first-person gun's reach); w unused
};

// one vertex of a tracer's quad (six a tracer, built on the host each frame)
struct TracerVertexGpu
{
    float4 pos;   // xyz the world position; w unused
    float4 uv;   // x across the tracer, -1 to 1; y along it, 0 at the tail and 1 at the head; z, w unused
    float4 color;   // rgb the tracer's colour times its HDR intensity (linear); a unused
};

// path guiding's update passes (rt/path_guiding_update.slang) push constants
struct GuidePush
{
    float4 camera;   // xyz the frame's camera position (the adaptive grid's levels), w unused
    uint4 config;   // x the frame (the tracer's sample index), y proposals (kGuideTrainVertices a pixel), z the pass (0 update, 1 owner, 2 write), w the lobes' prior (float bits)
};

// tracer draws (vfx/tracer.slang) push constants
struct TracerPush
{
    column_major float4x4 viewProj;   // the transparent pass's jittered view-projection
};

// the transparent pass's mesh shader (vfx/transparent_mesh.slang) push constants
struct ForwardPush
{
    column_major float4x4 view;   // the view matrix (the froxel's slice)
    float4 camera;   // xyz the camera's position, w unused
    float4 screen;   // x, y the frame's size; z, w the froxel slice scale and bias
    uint4 config;   // x lights (without clusters), y flags: 1 clustered, 2 RT GI, 4 environment (IBL), 8 TLAS (sun shadow ray)
    float4 env;   // x the environment's intensity
    column_major float4x4 proj;   // the jittered projection the G-buffer was drawn with (OpenPBR step 3: a refracted point's place in the lit frame)
};

// ibl/env_prefilter.slang push constants
struct EnvPrefilterPush
{
    uint4 size;   // x, y the output level's size; z samples a texel; w the source chain's mip count
    float4 params;   // x the level's GGX roughness (prefilter); y, z the source chain's base size; w unused
};

// the first 16 bytes of the smoke proxy buffer (set 1, binding 7 of rt/shadow_trace and rt/gi_trace): the spheres after it, SmokeSphereGpu each at kSmokeSpheresOffset
struct SmokeProxyHeaderGpu
{
    uint4 counts;   // x the spheres written; y 1 when the RT traces attenuate through them (render.settings vfx.smokeInGi), 0 when they ignore smoke; z, w unused
};

// one smoke proxy sphere this frame (vfx::SmokeSphere at the record's age): a closed-form density sphere the shadow and GI rays attenuate through
struct SmokeSphereGpu
{
    float4 centre;   // xyz the world centre; w the radius (m)
    float4 density;   // x the density (1/m: transmittance exp(-density * chord)); y, z, w unused
};
