#version 460
#extension GL_EXT_ray_query : require

// Wavefront stage: intersect + compact.
//
// Consumes queue N (index base pc.srcQueueBase, live count held in counter
// slot pc.srcCountSlot -- read from the SSBO, never from the CPU), traces
// each live path against the TLAS with an inline ray query, writes the hit
// distance into path state (PS_HIT_T) and sets Alive=0 on a miss. Survivors
// are compacted into queue N+1 (pc.dstQueueBase) by atomicAdd on counter
// slot pc.dstCountSlot: this is what makes a dead path free in the *next*
// dispatch -- it is never written into the next queue, so a
// wf_prepare_indirect.comp-derived dispatch over that queue never spends a
// thread on it.
//
// gl_GlobalInvocationID.x indexes a SLOT in the source queue, not a path
// index directly -- queues hold path indices, sparse relative to
// pc.capacity once any compaction has happened. This dispatch is sized
// indirectly (vkCmdDispatchIndirect from wf_prepare_indirect.comp's output),
// so it launches ceil(count / 64) * 64 threads; the tail beyond the live
// count returns early without touching path state or the destination queue.
//
// Every invocation that actually runs increments counters.value[canarySlot]
// before that early-return guard -- this is the canary probe check 13 reads
// to prove an indirect dispatch sized from a live-count of 0 launches zero
// workgroups (vkCmdDispatchIndirect with groupCountX == 0 dispatches no
// invocations at all, so the canary never even executes the increment).
//
// Both the source count and the destination write are clamped to pc.capacity.
// In the current probe this is unreachable -- WavefrontBuffers::zero resets
// counter slots to 0 and srcCount never exceeds capacity -- but this shader
// is parameterised (srcQueueBase/srcCountSlot/dstQueueBase/dstCountSlot) for
// reuse across bounces (N->N+1, N+1->N+2, ...), and the queue buffer is
// exactly 2*capacity uints. A caller that reuses a ring without re-zeroing
// its counter would otherwise write past the end of that allocation.
//
// GEOMETRIC NORMALS. A ray query reports a primitive index and
// barycentrics; it never reports a normal. Recovering one therefore means
// reading the hit triangle's own vertices back out of the same position and
// index buffers the BLAS was built from, which is why this stage binds them
// as storage buffers (3 and 4) alongside the acceleration structure. The
// normal written to path state is the FORWARD-FACING geometric normal --
// cross(v1 - v0, v2 - v0), normalised, then negated if it agrees with the
// ray direction -- because that is the orientation wf_scatter.comp's
// hemisphere basis and every future BSDF need. The raw winding-order normal
// is deliberately not what is stored, so nothing downstream has to know
// which way a given mesh happens to be wound.
//
// Object space == world space here: this stage assumes a single BLAS
// instanced once with an identity transform, which is what every probe
// builds. A scene with transformed instances would have to carry
// rayQueryGetIntersectionObjectToWorldEXT's inverse-transpose through this
// (and per-instance geometry offsets through the index lookup); nothing in
// this subsystem builds one yet, and adding the plumbing before there is a
// caller for it would be untestable code.
//
// Binding scheme: state (0, declared by path_state.glsl), queues (1, both
// rings back to back), counters (2), vertex positions (3), triangle indices
// (4), TLAS (5).

#include "diff/path_state.glsl"

layout(local_size_x = 64) in;

layout(std430, binding = 1) buffer QueueBuffer {
    uint idx[];
} queues;

layout(std430, binding = 2) buffer CounterBuffer {
    uint value[];
} counters;

// The exact buffers the BLAS was built from: 3 floats per vertex, 3 uints
// per triangle, tightly packed. Read-only -- this stage only ever consults
// them to reconstruct a hit triangle.
layout(std430, binding = 3) readonly buffer VertexPositionBuffer {
    float p[];
} geomVertices;

layout(std430, binding = 4) readonly buffer TriangleIndexBuffer {
    uint i[];
} geomIndices;

layout(binding = 5) uniform accelerationStructureEXT topLevelAS;

layout(push_constant) uniform Push {
    uint capacity;
    uint srcQueueBase;
    uint srcCountSlot;
    uint dstQueueBase;
    uint dstCountSlot;
    uint canarySlot;
} pc;

// The trace tMax every path ray in this stage is initialised with. NAMED
// rather than written as a bare literal inside rayQueryInitializeEXT,
// because checks 33-34's CPU reference integrator transcribes this exact
// number as its own escape threshold (kParityRayTMax): a ray that finds no
// geometry within it "escaped" on BOTH sides, and the two sides only mean
// the same thing while the two numbers agree. A bare literal has no name for
// diff_gpu_probe.cpp's checkParityRefConstantsTie to search for, so changing
// it would silently un-tie the reference from this shader; declared like
// this, that check parses it out of this source and refuses to run the probe
// if it has drifted. wf_scatter.comp's kShadowTMax is the same number for
// shadow rays, and is tied by the same check.
const float kTraceTMax = 1000.0;

vec3 wfGeomVertex(uint vertexIndex) {
    return vec3(geomVertices.p[vertexIndex * 3u + 0u],
                geomVertices.p[vertexIndex * 3u + 1u],
                geomVertices.p[vertexIndex * 3u + 2u]);
}

void main() {
    // Ran at all -- see probe check 13: with an indirect groupCountX of 0,
    // this line never executes, so the canary stays exactly 0.
    atomicAdd(counters.value[pc.canarySlot], 1u);

    const uint slot = gl_GlobalInvocationID.x;
    const uint srcCount = min(counters.value[pc.srcCountSlot], pc.capacity);
    if (slot >= srcCount) return;

    const uint pathIndex = queues.idx[pc.srcQueueBase + slot];

    const vec3 origin = psGetOrigin(pathIndex, pc.capacity);
    const vec3 dir = psGetDir(pathIndex, pc.capacity);

    rayQueryEXT rq;
    // tMin is 0, not an epsilon. An epsilon here is not a self-intersection
    // guard -- for a SCATTERED ray, wf_scatter.comp already offsets the next
    // ray's origin along the geometric normal and only ever samples
    // directions with dot(dir, normal) > 0, so that ray moves AWAY from the
    // surface it just left and cannot re-hit it at any t.
    //
    // That is provable, but it is NOT unconditional: it holds only while the
    // scatter offset is large enough to survive float rounding at the
    // scene's scale. At |coordinate| == E a float's ulp is E * epsilon, so
    // an offset at or below ~0.5 * ulp(E) rounds straight back to the hit
    // point and the next ray origin lands exactly ON the surface -- with
    // tMin = 0, that origin can then re-hit the face it just left at t ~ 0.
    // The offset is therefore bounded from BELOW as well as above, and both
    // bounds are enforced at compile time rather than assumed: see the
    // static_asserts on kFusedLoopScatterOriginOffset next to the fused-loop
    // scene constants in gpu_probe_context.cpp, which require it to exceed
    // 8 * E * FLT_EPSILON (= 8 ulp(E), ~16x the rounding-away threshold).
    // A future scene at a much larger E, or a smaller offset, breaks this
    // argument and fails that build -- it does not silently degrade. What a
    // positive tMin does instead is silently DROP legitimate hits closer
    // than it: on a closed scene, a bounce that lands within tMin of an edge
    // would have its next, perfectly real hit on the adjoining face
    // rejected, the ray would leave the scene through the gap, and the path
    // would die. That turns "every path survives every bounce" from a
    // theorem about the geometry into a near-edge probability -- see the
    // survival derivation in gpu_probe_context.cpp's fused-loop scene
    // constants, which depends on tMin being exactly 0.
    //
    // A PRIMARY ray (this bounce's first trace of a path, straight out of
    // wf_generate.comp) has none of that -- there is no 1e-4*normal offset
    // to reason about, because there was no prior hit to offset away from.
    // Its tMin = 0 safety rests on a different, simpler hypothesis instead:
    // the camera is not already sitting on a surface. wf_generate.comp:60
    // writes the camera position into path state verbatim, with no offset
    // of its own, so that hypothesis is exactly "the camera position is
    // strictly inside the scene, not on its boundary" -- which is precisely
    // what the fused-loop scene guard's condition 4 (camera max |coord| <
    // half-extent E) checks for the camera this probe actually uses. So the
    // same tMin = 0 both scattered and primary rays trace with is justified
    // by two different hypotheses -- the scatter offset for scattered rays,
    // the camera-not-on-a-surface guard for primary rays -- and both are
    // enforced, not assumed: see the static_asserts next to the fused-loop
    // scene constants in gpu_probe_context.cpp and this file's own
    // scattered-ray argument above.
    rayQueryInitializeEXT(rq, topLevelAS, gl_RayFlagsOpaqueEXT, 0xFF, origin, 0.0, dir,
                          kTraceTMax);
    while (rayQueryProceedEXT(rq)) { }

    if (rayQueryGetIntersectionTypeEXT(rq, true) == gl_RayQueryCommittedIntersectionNoneEXT) {
        psSetHitT(pathIndex, pc.capacity, -1.0);
        psSetAlive(pathIndex, pc.capacity, 0u);
        // Normal deliberately left untouched on a miss: there is no surface,
        // so there is no normal, and writing a placeholder would make a
        // stale value indistinguishable from a real one downstream.
        return;
    }

    psSetHitT(pathIndex, pc.capacity, rayQueryGetIntersectionTEXT(rq, true));

    // --- Geometric normal of the committed hit. ---
    const uint primitive = uint(rayQueryGetIntersectionPrimitiveIndexEXT(rq, true));
    const vec3 v0 = wfGeomVertex(geomIndices.i[primitive * 3u + 0u]);
    const vec3 v1 = wfGeomVertex(geomIndices.i[primitive * 3u + 1u]);
    const vec3 v2 = wfGeomVertex(geomIndices.i[primitive * 3u + 2u]);
    vec3 normal = normalize(cross(v1 - v0, v2 - v0));
    // Flip to oppose the incoming ray. Every probe scene is wound so that
    // this actually fires (see buildAxisAlignedBoxGeometry), which is what
    // keeps a missing flip observable rather than a no-op.
    if (dot(normal, dir) > 0.0) {
        normal = -normal;
    }
    psSetNormal(pathIndex, pc.capacity, normal);

    // Compaction: only survivors are written into the next queue, at an
    // offset handed out by atomicAdd on the next queue's counter slot. The
    // counter itself is always incremented (so an overflow is visible/
    // diagnosable via readbackCounter), but the write is skipped once the
    // offset would land outside the destination ring's capacity-sized
    // allocation.
    const uint dstSlot = atomicAdd(counters.value[pc.dstCountSlot], 1u);
    if (dstSlot < pc.capacity) {
        queues.idx[pc.dstQueueBase + dstSlot] = pathIndex;
    }
}
