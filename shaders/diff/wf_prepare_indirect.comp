#version 450

// Wavefront stage: prepare an indirect dispatch from a queue's live-path
// count.
//
// Converts the count sitting in counter slot `pc.countSlot` into a
// {groupCountX, 1, 1} vkCmdDispatchIndirect argument triple, written into
// THIS SAME counter buffer at `pc.argsSlot`..`pc.argsSlot`+2.
// VkDispatchIndirectCommand is a plain {x,y,z} uint32 triple, so that byte
// offset can be bound directly as vkCmdDispatchIndirect's buffer with no
// separate copy.
//
// groupCountX = ceil(count / 64), matching wf_intersect.comp's
// local_size_x = 64.
//
// The CPU never reads the count back to size a dispatch -- doing so would
// serialise every bounce on a host round-trip (submit, wait, read, submit
// again) and defeat the entire point of the wavefront architecture: the
// live-path count only exists, and only changes, on the GPU timeline. This
// shader is what keeps that count from ever crossing back to the host.
//
// Single invocation. Binding: counters only, at binding 0 (this stage does
// not touch path state or queues).

layout(local_size_x = 1) in;

layout(std430, binding = 0) buffer CounterBuffer {
    uint value[];
} counters;

layout(push_constant) uniform Push {
    uint countSlot;
    uint argsSlot;
} pc;

void main() {
    if (gl_GlobalInvocationID.x != 0u) return;

    const uint count = counters.value[pc.countSlot];
    // count + 63u overflows uint32 for count > 0xFFFFFFC0 (~4.29 billion),
    // which would wrap groupCountX to 0 and silently skip the bounce.
    // Unreachable at any capacity this subsystem allocates in practice (a
    // path-state arena that large would not fit in device memory), so this
    // is a documented limit rather than a guarded one.
    const uint groupCountX = (count + 63u) / 64u;

    counters.value[pc.argsSlot + 0u] = groupCountX;
    counters.value[pc.argsSlot + 1u] = 1u;
    counters.value[pc.argsSlot + 2u] = 1u;
}
