#version 460
// Float atomicAdd into the vertex-gradient arena, for the reason every
// gradient scatter in this subsystem needs it.
#extension GL_EXT_shader_atomic_float : require
// ITEM 6: the radiance on each side of a silhouette, TRACED rather than
// pushed. Declared here and unused until pc.traceRadiance says otherwise --
// see the note on that flag.
#extension GL_EXT_ray_query : require

// STAGE 3 -- THE BOUNDARY KERNEL, coverage form.
//
// Spec 4.1's second term, as a dispatch:
//
//     INTEGRAL_over_boundary  f * (v . n)  dl
//
// One invocation per (edge, pixel). The edge is clipped to the pixel, the
// integrand is evaluated over the resulting chord, and the result is
// scattered to the edge's TWO VERTICES with the barycentric weights that
// integral produces.
//
// WHAT THIS FORM DOES AND DOES NOT DO. The radiance on each side is an
// AFFINE FIELD OF SCREEN POSITION, L(x) = L0 + gradL . x, pushed rather than
// traced. It began as one constant per side, which made the jump constant
// along an edge; it is now allowed to VARY along the edge, which is the
// substantive half of what a trace would give and the reason the integration
// below is a moment integral rather than a weight times a scalar.
//
// WHY A VARYING FIELD STILL LEAVES THE GATE ATTRIBUTABLE, which is the whole
// reason this layer could be added without giving up the oracle: spec 4.1's
// interior term is INTEGRAL (df/dtheta) dx, and these fields do not depend on
// theta. They are fixed functions of screen position. So moving a vertex
// still changes nothing but which side of the edge each point is on, the
// interior integral is still EXACTLY zero, and a supersampled image
// derivative is still purely this integral -- now with a jump that varies
// along the chord instead of a constant one.
//
// WHAT IS STILL OWED. A traced radiance is not affine, so the two-point
// exactness below becomes a two-point quadrature and acquires a truncation
// term. Substituting two ray traces for the two fields is the next layer;
// everything beneath it -- the clip, the moments, the scatter, the arena
// addressing -- is what this dispatch exists to get right first.
//
// SCREEN SPACE IS WORLD XY (orthographic). Stated rather than assumed: a
// vertex's screen velocity is its world velocity, so no projection Jacobian
// enters. That derivative is real and belongs to the perspective case.
//
// THE GRADIENT IS A VECTOR PER VERTEX, two floats, and the two components
// are computed in ONE invocation rather than by dispatching twice with
// different directions. The integrand is linear in the displacement, so
// d = (1,0) and d = (0,1) give the two partials directly, and computing both
// here means the chord is clipped once instead of twice.

layout(local_size_x = 64) in;

// 2 floats per vertex: screen-space x, y.
layout(std430, binding = 0) readonly buffer VertexPositions {
    float v[];
} verts;

// 2 uints per edge: the endpoint vertex indices. Built once, on the host,
// by ohao::diff::EdgeAdjacency -- moving a vertex changes geometry, not
// connectivity, so this buffer is not rebuilt per iteration.
layout(std430, binding = 1) readonly buffer EdgeList {
    uint v[];
} edges;

// dJ/dvx and dJ/dvy per vertex, at `gradOffset + vertex * 2 + component`.
// atomicAdd, because many (edge, pixel) pairs land on the same vertex.
//
// THIS IS THE GRADIENT ARENA, not a buffer of this pass's own. Spec 4.1:
// "two separate kernels, two separate test suites, TWO GRADIENT
// CONTRIBUTIONS SUMMED INTO THE SAME ARENA". The interior term writes an
// appearance parameter's block, this writes a VertexPositions block, and
// `gradOffset` is what keeps them disjoint -- the same float index the
// interior kernel is given for its own parameter.
layout(std430, binding = 2) buffer VertexGradients {
    float v[];
} grad;

// One uint per edge, from silhouette_mark.comp: 1 if this edge is on the
// silhouette. NON-SILHOUETTE EDGES MUST CONTRIBUTE NOTHING, and that is a
// correctness requirement rather than an optimisation: an interior edge has
// the same surface on BOTH sides, so there is no radiance jump across it and
// the boundary integrand is zero there. Evaluating it anyway with a pushed
// jump -- which is what this pass would do without the filter -- invents a
// discontinuity that the geometry does not have.
//
// `useFlags == 0` processes every edge, which is what the single-triangle
// coverage case wants: a lone triangle against a background has a real jump
// across all three of its edges, and no silhouette pass is involved.
layout(std430, binding = 3) readonly buffer SilhouetteFlags {
    uint v[];
} silhouette;

// dL/d(pixel), one float per pixel. The boundary term for a real objective
// is
//
//     dL/dtheta = SUM_pixels  w[p] * (dI_p/dtheta)
//
// so each (edge, pixel) contribution is weighted by that pixel's own w. This
// is the same generalisation Stage 2 Task 1 made for the INTERIOR term, and
// for the same reason: without it the only objective expressible is the sum
// of the image, and an optimiser needs the loss's gradient instead.
//
// `useSeed == 0` means w = 1 everywhere, which IS the sum-of-image
// objective -- not a disabled state, the special case every check written
// before this one measures.
layout(std430, binding = 4) readonly buffer AdjointSeed {
    float v[];
} seed;

// ITEM 6, TASK 1. The scene, for tracing the radiance at a chord instead of
// reading it off a push constant.
//
// BOUND BUT NOT YET READ. This task adds the bindings and the flag and
// nothing else, so that the REGRESSION GATE can run before the integrand
// changes: with pc.traceRadiance == 0 every check from 37 to 68 must still
// produce its original numbers. A new binding that perturbs an existing
// result means the descriptor set or the push block is wrong, and that is
// far easier to find now than after the mathematics moves too.
layout(binding = 5) uniform accelerationStructureEXT topLevelAS;

// One emission value per primitive, indexed by the ray query's primitive
// index. Constant per surface, which is what makes the traced jump PIECEWISE
// CONSTANT along a chord and keeps the moment integral exact -- see the item
// 6 plan for why that means 6a does not want a convergence gate.
layout(std430, binding = 6) readonly buffer PrimitiveEmission {
    float v[];
} emission;

layout(push_constant) uniform Push {
    uint edgeCount;
    uint imageWidth;
    uint imageHeight;
    uint vertexCount;
    // Radiance on the NEGATIVE side of the edge normal, and on the positive
    // side, each as an affine field of GLOBAL screen position:
    //
    //     L(x) = lIn + gradIn . x        (and lOut, gradOut)
    //
    // The constant-per-side case is gradIn = gradOut = 0, and it reproduces
    // the earlier form's numbers exactly rather than approximately -- the
    // moments below collapse to the old weights when the jump is constant.
    //
    // The normal convention is the one below, and it must match the host's --
    // a disagreement is an exact sign flip, which is how the CPU form's own
    // sign error was found.
    float lIn;
    float lOut;
    vec2 gradIn;
    vec2 gradOut;
    // 0: every edge contributes. 1: only edges the silhouette pass marked.
    uint useFlags;
    // 0: w = 1 everywhere. 1: read binding 4.
    uint useSeed;
    // FLOAT index of this parameter's block within the arena, not a byte
    // offset -- the same convention gradAlbedoOffset uses on the interior
    // side. 0 when the caller bound a standalone buffer.
    uint gradOffset;
    // ITEM 6: 0 uses lIn/lOut and their gradients as before; 1 traces.
    uint traceRadiance;
    uint primitiveCount;
    // Screen <-> world, which is AFFINE here because this pass is
    // orthographic by construction: screen = world.xy * screenScale +
    // screenOffset. The inverse is what turns a chord point into a ray.
    float screenScale;
    vec2 screenOffset;
    // Where the orthographic ray starts, and how far to either side of the
    // edge the two samples are taken. The epsilon must be small enough to
    // stay on the correct side of a neighbouring edge and large enough to
    // clear the one being integrated; the host picks it and check 69 asserts
    // the result does not depend on the choice.
    float rayOriginZ;
    float traceEps;
    // What a miss returns.
    float background;
    // ITEM 6 TASK 3: a radiance that varies WITHIN a surface, so the traced
    // jump stops being piecewise constant along a chord and the midpoint rule
    // stops being exact.
    //
    //     L(x) = emission[prim] * (1 + shadeAmp * sin(shadeFreq * world.x))
    //
    // Deliberately NOT affine. An affine variation is integrated EXACTLY by
    // the moments -- that is what check 64 does with a pushed field -- so it
    // would leave nothing whose order could be measured. A sine has every
    // order.
    float shadeAmp;
    float shadeFreq;
    // How many sub-chords the chord splits into, each sampled at its own
    // midpoint. THE QUADRATURE'S STEP SIZE, and the only reason it is a
    // parameter at all: a convergence gate needs a knob to turn. 1 reproduces
    // the unsubdivided form exactly, which is what keeps check 69 green.
    uint traceSubdivisions;
} pc;

/// The radiance at one GLOBAL screen point, by tracing.
///
/// ORTHOGRAPHIC, which is not a simplification here but the pass's existing
/// premise: `boundary_sample.comp` has always taken screen space to be world
/// xy, and checks 57-68 are written against that. So the ray is straight down
/// -z from a plane above the scene, and the only work is undoing the affine
/// screen map.
///
/// PIECEWISE CONSTANT, because emission is per primitive. That is what keeps
/// the moment integral below EXACT rather than a quadrature: along a chord
/// that does not cross a second silhouette the traced jump does not vary, so
/// the j1 term is zero and there is no truncation error to bound. A SHADED
/// radiance would change that, and is the layer after this one.
/// TWO POINTS, and the separation is the whole correctness of this function.
///
/// `probePoint` decides WHICH SURFACE -- it is nudged off the edge by
/// traceEps so the ray commits to one side of the discontinuity. `shadePoint`
/// decides WHERE ON IT the radiance is read, and that must be the chord point
/// itself, because spec 4.1's boundary integral wants the radiance AT the
/// boundary approached from each side, not a little way inside.
///
/// Using the nudged point for both costs an O(traceEps) bias that does NOT
/// shrink as the chord is subdivided -- so it survives any amount of
/// quadrature refinement. It is invisible for a radiance that is constant per
/// surface, which is why check 69 agreed to the exact float, and it is what
/// made check 70's converged run disagree with a supersampled oracle by a
/// factor of two while its convergence ratios looked perfect. Convergence to
/// the wrong number is still convergence; that is why check 70 measures both.
float tracedRadianceAt(vec2 probePoint, vec2 shadePoint) {
    const vec2 world = (probePoint - pc.screenOffset) / pc.screenScale;
    const vec2 shadeWorld = (shadePoint - pc.screenOffset) / pc.screenScale;
    const vec3 origin = vec3(world, pc.rayOriginZ);
    const vec3 dir = vec3(0.0, 0.0, -1.0);

    rayQueryEXT rq;
    rayQueryInitializeEXT(rq, topLevelAS, gl_RayFlagsOpaqueEXT, 0xFF, origin, 0.0, dir, 1e30);
    while (rayQueryProceedEXT(rq)) { }
    if (rayQueryGetIntersectionTypeEXT(rq, true) == gl_RayQueryCommittedIntersectionNoneEXT) {
        return pc.background;
    }
    const uint prim = uint(rayQueryGetIntersectionPrimitiveIndexEXT(rq, true));
    // The bounds test is the same one every arena write in this subsystem
    // carries: the shader is told a count and cannot verify the buffer holds
    // it, so a short buffer would read past its end.
    if (prim >= pc.primitiveCount) return pc.background;
    // Shaded in WORLD x, so a host oracle can evaluate the same function
    // without knowing anything about the screen map. shadeAmp == 0 is the
    // piecewise-constant case check 69 gates.
    return emission.v[prim] * (1.0 + pc.shadeAmp * sin(pc.shadeFreq * shadeWorld.x));
}

/// Liang-Barsky clip of the segment to the pixel, in the segment's parameter.
/// Returns false when the edge misses the pixel entirely.
///
/// THE PIXEL IS HALF-OPEN: [0,1) on both axes, so it owns its LOWER and LEFT
/// boundaries and not its upper and right ones.
///
/// Without that, an edge lying exactly along a pixel seam is a valid chord
/// for BOTH neighbours -- local x = 1 for the pixel on one side, local x = 0
/// for the pixel on the other -- and its contribution is scattered twice, so
/// the gradient comes out at exactly double. Check 70's supersampled oracle
/// measured precisely that: 2.00007, 1.99987, 1.99773 times the truth on
/// every component.
///
/// The case is measure-zero for a general edge and unmissable for an
/// axis-aligned one on integer coordinates, which is exactly what a test
/// scene tends to be. It went unseen because the checks that compare two
/// forms of this kernel against EACH OTHER share the doubling and cancel it;
/// only an oracle with no pixel clip in it could see past that.
///
/// Only the PARALLEL case changes. A segment not parallel to a boundary has
/// p[i] != 0 and never reaches this branch, so every non-degenerate chord is
/// clipped exactly as before -- which is why every existing check reproduces
/// byte for byte.
bool clipToPixel(vec2 p0, vec2 p1, out float uA, out float uB) {
    const vec2 d = p1 - p0;
    uA = 0.0;
    uB = 1.0;
    const float p[4] = float[4](-d.x, d.x, -d.y, d.y);
    const float q[4] = float[4](p0.x, 1.0 - p0.x, p0.y, 1.0 - p0.y);
    // Which of the four half-planes are the pixel's UPPER bounds: q[1] is
    // 1 - x and q[3] is 1 - y, so those are the ones the half-open interval
    // excludes.
    const bool upper[4] = bool[4](false, true, false, true);
    for (int i = 0; i < 4; ++i) {
        if (p[i] == 0.0) {
            // Parallel to this boundary. q[i] == 0 means the segment lies
            // ON it: the pixel below/left of the seam keeps it, the one
            // above/right rejects it, so it is counted once.
            if (q[i] < 0.0 || (upper[i] && q[i] == 0.0)) return false;
            continue;
        }
        const float t = q[i] / p[i];
        if (p[i] < 0.0) {
            uA = max(uA, t);
        } else {
            uB = min(uB, t);
        }
    }
    return uA < uB;
}

void main() {
    const uint id = gl_GlobalInvocationID.x;
    const uint pixels = pc.imageWidth * pc.imageHeight;
    if (pixels == 0u || id >= pc.edgeCount * pixels) return;

    const uint edge = id / pixels;
    const uint pixel = id % pixels;
    const uint px = pixel % pc.imageWidth;
    const uint py = pixel / pc.imageWidth;

    if (pc.useFlags != 0u && silhouette.v[edge] == 0u) return;

    const uint i0 = edges.v[edge * 2u + 0u];
    const uint i1 = edges.v[edge * 2u + 1u];
    if (i0 >= pc.vertexCount || i1 >= pc.vertexCount) return;

    // The edge in THIS pixel's local frame: Task 3's integrand is written for
    // a unit pixel, and a unit pixel here IS one pixel, so no scale enters.
    const vec2 p0 = vec2(verts.v[i0 * 2u + 0u], verts.v[i0 * 2u + 1u]) - vec2(px, py);
    const vec2 p1 = vec2(verts.v[i1 * 2u + 0u], verts.v[i1 * 2u + 1u]) - vec2(px, py);

    float uA, uB;
    if (!clipToPixel(p0, p1, uA, uB)) return;

    const vec2 seg = p1 - p0;
    const float len = length(seg);
    if (len <= 0.0) return;
    // The direction rotated +90 degrees. "Inside" is the NEGATIVE side of
    // this, which is the host's convention too.
    const vec2 n = vec2(-seg.y, seg.x) / len;

    // THE MOMENTS OF THE CHORD, in the segment's own parameter u. The vertex
    // weights are (1-u) for p0 and u for p1, and the jump is now affine in u,
    // so each vertex's contribution is a second moment rather than a weight
    // times a scalar:
    //
    //     M_k = INTEGRAL_{uA}^{uB} u^k du
    //
    // M0 is the rigid-translation weight the conservation identity asserts,
    // and with a CONSTANT jump the two expressions below collapse to
    // jump*(M0 - M1) and jump*M1 -- the earlier form, exactly.
    const float m0 = uB - uA;
    const float m1 = 0.5 * (uB * uB - uA * uA);
    const float m2 = (uB * uB * uB - uA * uA * uA) / 3.0;

    // THE PIXEL'S WEIGHT. Applied to the WHOLE contribution rather than to
    // one of the two vertex terms -- Stage 2 Task 1 got that wrong for the
    // interior term (seeding the adjoint left the throughput-derivative term
    // unweighted, and check 50's partition identity caught it), and the same
    // shape of mistake is available here: weighting only k0 would leave the
    // p1 half carrying w = 1.
    const float w = (pc.useSeed != 0u) ? seed.v[pixel] : 1.0;

    // THE JUMP ALONG THE CHORD, affine in u. Evaluated in GLOBAL screen
    // coordinates -- p0 is pixel-local, so the pixel's own corner goes back
    // in here. Getting that wrong would make every pixel evaluate the field
    // as though it sat at the origin, which is invisible for a constant
    // field and is exactly what this layer changes.
    const vec2 g0 = p0 + vec2(px, py);

    // Each branch produces the two VERTEX WEIGHTS directly rather than a
    // jump the caller then integrates: the traced path accumulates its own
    // sub-interval moments, so handing back a j0/j1 pair would mean applying
    // the moments twice.
    float w0;
    float w1;
    if (pc.traceRadiance != 0u) {
        // TRACED, as a MIDPOINT RULE over `traceSubdivisions` sub-chords.
        // Exact while the jump is piecewise constant (check 69); a one-point
        // quadrature per sub-chord once shadeAmp makes it vary.
        //
        // "Inside" is the NEGATIVE side of n, this pass's convention
        // everywhere and the thing a reversed winding silently swaps.
        const uint subdivisions = max(pc.traceSubdivisions, 1u);
        const float du = (uB - uA) / float(subdivisions);
        w0 = 0.0;
        w1 = 0.0;
        for (uint s = 0u; s < subdivisions; ++s) {
            const float s0 = uA + float(s) * du;
            const float s1 = s0 + du;
            const vec2 mid = g0 + (0.5 * (s0 + s1)) * seg;
            const float lIn = tracedRadianceAt(mid - pc.traceEps * n, mid);
            const float lOut = tracedRadianceAt(mid + pc.traceEps * n, mid);
            const float jump = (lIn - lOut) * w;
            // The same moments as the affine branch, over this sub-interval
            // only -- so the weights stay the (1-u) and u the integral
            // produces rather than a flat share.
            const float sm0 = s1 - s0;
            const float sm1 = 0.5 * (s1 * s1 - s0 * s0);
            w0 += jump * (sm0 - sm1);
            w1 += jump * sm1;
        }
    } else {
        const vec2 dGrad = pc.gradIn - pc.gradOut;
        const float j0 = ((pc.lIn - pc.lOut) + dot(dGrad, g0)) * w;
        const float j1 = dot(dGrad, seg) * w;
        // INTEGRAL (j0 + j1 u)(1-u) du and INTEGRAL (j0 + j1 u) u du.
        w0 = j0 * (m0 - m1) + j1 * (m1 - m2);
        w1 = j0 * m1 + j1 * m2;
    }

    // Both partials at once: d = (1,0) gives (d.n) = n.x, d = (0,1) gives n.y.
    const float k0 = len * w0;
    const float k1 = len * w1;

    const uint base0 = pc.gradOffset + i0 * 2u;
    const uint base1 = pc.gradOffset + i1 * 2u;
    atomicAdd(grad.v[base0 + 0u], k0 * n.x);
    atomicAdd(grad.v[base0 + 1u], k0 * n.y);
    atomicAdd(grad.v[base1 + 0u], k1 * n.x);
    atomicAdd(grad.v[base1 + 1u], k1 * n.y);
}
