#version 460

// The NRD frame: NRD's denoised diffuse remodulated by the first hit's diffuse albedo (the tracer
// divided it out), its denoised specular as it is (the tracer did not), and the camera ray's
// emission, which never passes through NRD:
//   composed = denoisedDiff * diffAlbedo + denoisedSpec + emission
// written as HDR and as the frame's output with the tracer's curve (ACES at 0.5, gamma 2.2), so a
// window presents the denoised frame and a capture reads it. REBLUR's output is YCoCg.

#extension GL_GOOGLE_include_directive : require
#include "includes/rt/nrd_frontend.glsl"

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(set = 0, binding = 0, rgba32f) uniform readonly  image2D inDiffRad;     // NRD's denoised diffuse
layout(set = 0, binding = 1, rgba32f) uniform readonly  image2D inSpecRad;     // NRD's denoised specular
layout(set = 0, binding = 2, rgba8)   uniform readonly  image2D inDiffAlbedo;  // the diffuse albedo (PT 24)
layout(set = 0, binding = 3, rgba8)   uniform readonly  image2D inSpecColor;   // unused: DLSS's specular guide (PT 25)
layout(set = 0, binding = 4, rgba32f) uniform writeonly image2D outComposed;   // HDR
layout(set = 0, binding = 5, rgba16f) uniform readonly  image2D inEmission;    // the camera ray's emission (PT 13)
layout(set = 0, binding = 6, rgba8)   uniform writeonly image2D outLdr;        // the frame's output (PT 2)

vec3 aces(vec3 x) { return clamp((x * (2.51 * x + 0.03)) / (x * (2.43 * x + 0.59) + 0.14), 0.0, 1.0); }

void main() {
    ivec2 p    = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(outComposed);
    if (p.x >= size.x || p.y >= size.y) return;

    // Back-end unpack: REBLUR writes YCoCg in .rgb (see REBLUR_BackEnd_UnpackRadianceAndNormHitDist).
    vec3 diffRad    = nrdYCoCgToLinear(imageLoad(inDiffRad,    p).rgb);
    vec3 specRad    = nrdYCoCgToLinear(imageLoad(inSpecRad,    p).rgb);
    vec3 diffAlbedo = imageLoad(inDiffAlbedo, p).rgb;
    vec3 emission   = imageLoad(inEmission,   p).rgb;

    vec3 composed = diffRad * diffAlbedo + specRad + emission;

    imageStore(outComposed, p, vec4(composed, 1.0));
    imageStore(outLdr, p, vec4(pow(aces(composed * 0.5), vec3(1.0 / 2.2)), 1.0));
}
