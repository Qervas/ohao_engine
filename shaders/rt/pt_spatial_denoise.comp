#version 460
// The path tracer's internal spatial denoise (RTRenderSettings::enableInternalDenoise),
// run after the trace. It reads the finished accumulation (binding 1 of the trace) and
// the normal AOV, so every tap is a pixel some invocation of the trace wrote before
// this dispatch began; run inside the raygen, the taps read neighbours that other
// invocations of the same dispatch were still writing (the rt_realtime race).
//
// Filter: local variance from the 3x3 neighbourhood; if the pixel is noisy, one 5x5
// edge-aware pass (spatial Gaussian x normal similarity^48 x colour similarity); the
// result is rescaled to the accumulation's luminance, then ACES at exposure 0.5 and
// gamma 2.2 into the RGBA8 beauty, as the raygen's own tonemap.

layout(local_size_x = 16, local_size_y = 16) in;

layout(set = 0, binding = 0, rgba32f) uniform readonly image2D accumImage;
layout(set = 0, binding = 1, rgba32f) uniform readonly image2D normalAOV;
layout(set = 0, binding = 2, rgba8) uniform writeonly image2D outputImage;

layout(push_constant) uniform PushConstants {
    uvec2 size;
} pc;

const int kApron = 2;                        // the 5x5 kernel's radius
const int kTile = 16 + 2 * kApron;           // 20x20 texels per workgroup
shared vec4 sColor[kTile * kTile];           // rgb = accumulation, w = 1 inside the image
shared vec3 sNormal[kTile * kTile];

vec3 ACES(vec3 x) {
    return clamp((x * (2.51 * x + 0.03)) / (x * (2.43 * x + 0.59) + 0.14), 0.0, 1.0);
}

// x^48 by squaring (x^32 * x^16): five multiplies instead of a pow's log2/exp2.
float pow48(float x) {
    const float x2 = x * x, x4 = x2 * x2, x8 = x4 * x4, x16 = x8 * x8;
    return x16 * x16 * x16;
}

void main() {
    const ivec2 groupOrigin = ivec2(gl_WorkGroupID.xy) * 16 - kApron;
    const ivec2 size = ivec2(pc.size);
    for (int i = int(gl_LocalInvocationIndex); i < kTile * kTile; i += 256) {
        const ivec2 p = groupOrigin + ivec2(i % kTile, i / kTile);
        const bool inside = all(greaterThanEqual(p, ivec2(0))) && all(lessThan(p, size));
        sColor[i] = inside ? vec4(imageLoad(accumImage, p).rgb, 1.0) : vec4(0.0);
        sNormal[i] = inside ? imageLoad(normalAOV, p).rgb : vec3(0.0);
    }
    barrier();

    const ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    if (any(greaterThanEqual(pixel, size))) return;
    const ivec2 local = ivec2(gl_LocalInvocationID.xy) + kApron;
    const int center = local.y * kTile + local.x;
    const vec3 acc = sColor[center].rgb;
    const vec3 centerNormal = sNormal[center];

    vec3 mean = vec3(0.0);
    vec3 meanSq = vec3(0.0);
    float count = 0.0;
    for (int dy = -1; dy <= 1; ++dy) {
        for (int dx = -1; dx <= 1; ++dx) {
            const vec4 s = sColor[(local.y + dy) * kTile + local.x + dx];
            mean += s.rgb * s.w;
            meanSq += s.rgb * s.rgb * s.w;
            count += s.w;
        }
    }
    mean /= count;
    const vec3 variance = max(meanSq / count - mean * mean, vec3(0.0));
    const float noiseLevel = dot(variance, vec3(0.333));

    vec3 denoised = acc;
    if (noiseLevel > 0.00005) {
        // exp(-d2 / 4) for the squared tap distances 0, 1, 2, 4, 5, 8: one Gaussian, a table.
        const float kSpatial[9] = float[](1.0, 0.7788008, 0.6065307, 0.0, 0.3678794, 0.2865048, 0.0, 0.0,
                                          0.1353353);
        const float invSigmaC = 1.0 / (max(noiseLevel * 3.0, 0.001) + 0.0001);
        vec3 sum = vec3(0.0);
        float wSum = 0.0;
        for (int dy = -2; dy <= 2; ++dy) {
            for (int dx = -2; dx <= 2; ++dx) {
                const int t = (local.y + dy) * kTile + local.x + dx;
                if (sColor[t].w == 0.0) continue;
                const vec3 sampleColor = sColor[t].rgb;
                const float ws = kSpatial[dx * dx + dy * dy];
                const float wn = pow48(max(dot(centerNormal, sNormal[t]), 0.0));
                const vec3 colorDiff = acc - sampleColor;
                const float wc = exp(-dot(colorDiff, colorDiff) * invSigmaC);
                const float w = ws * wn * wc;
                sum += sampleColor * w;
                wSum += w;
            }
        }
        if (wSum > 0.001) denoised = sum / wSum;
    }

    const float accLum = dot(acc, vec3(0.2126, 0.7152, 0.0722));
    const float denLum = dot(denoised, vec3(0.2126, 0.7152, 0.0722));
    if (denLum > 0.001 && accLum > 0.001) denoised *= accLum / denLum;

    const vec3 ldr = pow(ACES(denoised * 0.5), vec3(1.0 / 2.2));
    imageStore(outputImage, pixel, vec4(ldr, 1.0));
}
