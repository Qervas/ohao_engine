#version 460
#extension GL_EXT_ray_tracing : require
#extension GL_EXT_nonuniform_qualifier : require
#extension GL_GOOGLE_include_directive : require

#include "includes/scene/scene_data.glsl"
#include "shared/layout.glsl"

// Path tracer any-hit: alpha (sub-project 12, "Materials: alpha modes"). It runs only for
// instances the TLAS marks non-opaque (an alpha-tested or blended material): coverage is the
// base colour's alpha x the albedo texture's (lod 0) x opacity (material row 3).
//   opaque   accepted (another material made the instance non-opaque);
//   mask     ignored below the cutoff, as core/gbuffer_mask.frag and rt/alpha_test.slang;
//   blend    stochastic opacity: accepted with probability = coverage, by a hash of the ray
//            (launch pixel, origin, direction) and the hit, so samples converge to the blend.

hitAttributeEXT vec2 baryCoord;

// Same RenderScene bindings as pt_closesthit.rchit.
layout(set = 0, binding = 4, std430)  readonly buffer VertexArena { float vtx[]; };        // Vertex = 25 floats
layout(set = 0, binding = 5, std430)  readonly buffer IndexArena { uint idx[]; };          // mesh-local
layout(set = 0, binding = 8, std430)  readonly buffer MeshTable { MeshGpu meshes[]; };
layout(set = 0, binding = 9, std430)  readonly buffer TriangleSlots { uint triSlot[]; };
layout(set = 0, binding = 10, std430) readonly buffer MatColorBuffer { vec4 matColors[]; } matColorBuf;
layout(set = 0, binding = 36, std430) readonly buffer Instances { InstanceGpu instances[]; };
layout(set = 0, binding = 37, std430) readonly buffer MaterialRefs { uint materialRefs[]; };
layout(set = 0, binding = 12) uniform sampler2D textures[];
// Binding 12's size (PathTracer::bindlessCapacity). An index at or past it is "no texture".
layout(constant_id = 1) const uint OHAO_BINDLESS_COUNT = 4096u;

vec2 vtxUV(uint v) { uint b = v * 25u + 9u; return vec2(vtx[b], vtx[b + 1u]); }

uint pcg(uint v) {
    uint state = v * 747796405u + 2891336453u;
    uint word = ((state >> ((state >> 28u) + 4u)) ^ state) * 277803737u;
    return (word >> 22u) ^ word;
}

void main() {
    // Barycentric interpolation
    float u = baryCoord.x;
    float v = baryCoord.y;
    float w = 1.0 - u - v;

    // Instance slot -> mesh -> material
    InstanceGpu inst = instances[gl_InstanceCustomIndexEXT];
    MeshGpu mesh = meshes[inst.mesh];
    uint slot = triSlot[mesh.triangleSlotOffset + uint(gl_PrimitiveID)];
    uint matID = OHAO_MATERIAL_INDEX(inst, slot, materialRefs);
    vec4 matColor = matColorBuf.matColors[matID * kMaterialRows + 0u];
    vec4 alphaRow = matColorBuf.matColors[matID * kMaterialRows + 3u];   // mode, cutoff, opacity, base alpha
    uint mode = uint(alphaRow.x + 0.5);
    if (mode == kAlphaOpaque) return;
    uint diffuseTexIdx = floatBitsToUint(matColor.a);

    float alpha = alphaRow.w * alphaRow.z;
    if (diffuseTexIdx < OHAO_BINDLESS_COUNT) {
        uint baseIdx = mesh.indexOffset + uint(gl_PrimitiveID) * 3u;
        uint i0 = mesh.vertexOffset + idx[baseIdx + 0u];
        uint i1 = mesh.vertexOffset + idx[baseIdx + 1u];
        uint i2 = mesh.vertexOffset + idx[baseIdx + 2u];
        vec2 texUV = w * vtxUV(i0) + u * vtxUV(i1) + v * vtxUV(i2);
        alpha *= textureLod(textures[nonuniformEXT(diffuseTexIdx)], texUV, 0.0).a;
    }

    if (mode == kAlphaMask) {
        if (alpha < alphaRow.y) ignoreIntersectionEXT;
        return;
    }
    // Blend: a uniform number from the ray and the hit (deterministic run to run).
    uint h = pcg(gl_LaunchIDEXT.x ^ pcg(gl_LaunchIDEXT.y ^ pcg(uint(gl_PrimitiveID) ^ pcg(gl_InstanceCustomIndexEXT))));
    h = pcg(h ^ floatBitsToUint(gl_WorldRayOriginEXT.x) ^ pcg(floatBitsToUint(gl_WorldRayOriginEXT.y) ^
                                                             floatBitsToUint(gl_WorldRayDirectionEXT.z)));
    if (float(h >> 8u) * (1.0 / 16777216.0) >= alpha) ignoreIntersectionEXT;
}
