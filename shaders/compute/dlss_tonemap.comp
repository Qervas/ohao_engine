#version 460
// DLSS Ray Reconstruction's frame: DLSS writes a denoised HDR-linear image (COLOR_OUT, RGBA16F);
// this pass writes it to the frame's output with the tracer's curve (ACES at 0.5, gamma 2.2), the
// same transform the tracer and nrd_compose use, so every denoiser's frame is displayed alike.

layout(local_size_x = 8, local_size_y = 8) in;

layout(set = 0, binding = 0, rgba16f) uniform readonly  image2D hdrIn;   // DLSS COLOR_OUT (HDR linear)
layout(set = 0, binding = 1, rgba8)   uniform writeonly image2D ldrOut;  // the frame's output (RGBA8)

vec3 ACES(vec3 x) {
    return clamp((x * (2.51 * x + 0.03)) / (x * (2.43 * x + 0.59) + 0.14), 0.0, 1.0);
}

void main() {
    ivec2 pix  = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(hdrIn);
    if (pix.x >= size.x || pix.y >= size.y) return;
    vec3 hdr = max(imageLoad(hdrIn, pix).rgb, vec3(0.0));
    imageStore(ldrOut, pix, vec4(pow(ACES(hdr * 0.5), vec3(1.0 / 2.2)), 1.0));
}
