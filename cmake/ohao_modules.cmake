# The engine's modules (step 4b-6b; docs/specs/2026-11-18-engine-modules-design.md, section 7). A module is one
# directory and one library:
#
#   ohao_add_module(<name> DEPENDS <module>... LINKS <library>... [SOURCES <explicit list>])
#
# builds the static library ohao_<name> from its directory's sources (private/ included; SOURCES replaces the glob),
# with the one include root ohao/, linking ohao_<dep> for each DEPENDS and each LINKS (PUBLIC). DEPENDS is the one
# source of the module graph: it writes ${CMAKE_BINARY_DIR}/generated/modules/<name>_dependencies.hpp
# (k<Name>Dependencies, which the module's dependencies() returns; rewritten only when its text changes, so a configure
# rebuilds nothing), and the module's level (cmake/ohao_layers.cmake) and what its sources may include
# (tools/check_layers.py) follow from it.
function(ohao_add_module name)
    cmake_parse_arguments(M "" "" "DEPENDS;LINKS;SOURCES" ${ARGN})
    if(M_SOURCES)
        set(sources ${M_SOURCES})
    else()
        file(GLOB_RECURSE sources CONFIGURE_DEPENDS "${CMAKE_CURRENT_SOURCE_DIR}/*.cpp" "${CMAKE_CURRENT_SOURCE_DIR}/*.hpp")
    endif()
    add_library(ohao_${name} STATIC ${sources})
    target_include_directories(ohao_${name} PUBLIC ${CMAKE_SOURCE_DIR}/ohao ${CMAKE_BINARY_DIR}/generated)
    target_compile_features(ohao_${name} PUBLIC cxx_std_20)
    foreach(dep ${M_DEPENDS})
        target_link_libraries(ohao_${name} PUBLIC ohao_${dep})
    endforeach()
    if(M_LINKS)
        target_link_libraries(ohao_${name} PUBLIC ${M_LINKS})
    endif()

    # k<Name>Dependencies: "physics" -> kPhysicsDependencies, "world_render" -> kWorldRenderDependencies.
    string(REPLACE "_" ";" words "${name}")
    set(camel "")
    foreach(w ${words})
        string(SUBSTRING "${w}" 0 1 first)
        string(TOUPPER "${first}" first)
        string(SUBSTRING "${w}" 1 -1 rest)
        string(APPEND camel "${first}${rest}")
    endforeach()
    list(LENGTH M_DEPENDS n)
    set(items "")
    foreach(dep ${M_DEPENDS})
        string(APPEND items " \"${dep}\",")
    endforeach()
    string(CONCAT text "#pragma once\n// Generated by ohao_add_module (cmake/ohao_modules.cmake) from ${name}'s DEPENDS: never edit.\n"
             "#include <array>\n#include <string_view>\n\nnamespace ohao {\ninline constexpr std::array<std::string_view, ${n}> "
             "k${camel}Dependencies{${items}};\n}\n")
    set(file "${CMAKE_BINARY_DIR}/generated/modules/${name}_dependencies.hpp")
    set(old "")
    if(EXISTS "${file}")
        file(READ "${file}" old)
    endif()
    if(NOT old STREQUAL text)
        file(WRITE "${file}" "${text}")
    endif()

    set_property(GLOBAL APPEND PROPERTY OHAO_MODULES ${name})
    set_property(GLOBAL PROPERTY OHAO_MODULE_DEPENDS_${name} ${M_DEPENDS})
endfunction()
