# Shell scripts must keep LF wherever they are checked out: a CRLF
# shebang fails on Linux with "bad interpreter: /bin/bash^M". Deliberately
# narrow -- a repo-wide "text=auto" here would renormalise every tracked
# file on the next checkout, which is not a change to make in passing.
*.sh text eol=lf

# Canonical engine output is compared byte-for-byte and is LF by definition: goldens
# of generated schemas and scene files must check out exactly as the engine writes them.
tests/reflect/golden/** text eol=lf
tests/scene/golden/** text eol=lf
tests/scenes/** text eol=lf
*.scene.json text eol=lf
# The CLI's expected stdout and the inputs its cases feed it (sub-project 3, step 9).
tests/cli/** text eol=lf
# `ohao serve`'s scripted sessions and their expected stdout (sub-project 4, step 5).
tests/serve/sessions/** text eol=lf
tests/serve/expected/** text eol=lf
# The shared layout and what tools/gen_layout.py writes from it; `--check` compares
# bytes (sub-project 2b, step 6).
shaders/shared/** text eol=lf
ohao/gpu/shared_layout.hpp text eol=lf
shaders/slangc.version text eol=lf
# The Khronos validation pack: third-party files kept byte for byte as published (the
# .gltf JSON and READMEs included), so their attribution and the goldens never drift.
assets/khronos/** -text
# Checked-in levels (sub-project 5): byte for byte, so a Blender rebuild compares exactly.
assets/levels/** -text
# glTF structure fixtures (sub-project 5, step 2): byte offsets and extras text are asserted.
tests/level/fixtures/** text eol=lf
# The level hint schema (step 3): `ohao schema level-extras`' output, compared byte for byte.
tests/level/extras_schema.json text eol=lf
# The animation test rig (sub-project 10): tools/anim/make_test_rig.py's output, byte for byte.
tests/anim/fixtures/** -text
# Characters (sub-project 10): generated files, byte for byte (the arms' Blender rebuild compares).
assets/characters/** -text
# VFX content (sub-project 12): generated files, byte for byte (tools/vfx/make_alpha_card.py --check).
assets/vfx/*.gltf -text
