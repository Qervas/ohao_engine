{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ohao:scene:1",
  "title": "OHAO scene (*.scene.json), document version 1",
  "description": "Generated from the engine type registry; schemaHash eab21e250bf7e019. Missing fields take their defaults. Unknown component blocks are preserved; unknown fields inside known components are errors. Ids, parents, cycles and singletons are checked by the engine.",
  "type": "object",
  "required": ["format", "version", "entities"],
  "properties": {
    "format": { "const": "ohao.scene" },
    "version": { "const": 1 },
    "components": { "type": "object", "additionalProperties": { "type": "integer", "minimum": 1 } },
    "entities": { "type": "array", "items": { "$ref": "#/$defs/Entity" } }
  },
  "additionalProperties": false,
  "$defs": {
    "EntityId": {
      "description": "Stable entity id: 16 lowercase hex digits, never all zero.",
      "type": "string",
      "pattern": "^(?!0{16})[0-9a-f]{16}$"
    },
    "AssetRef": {
      "description": "Asset reference: project-relative path with '/' separators; guid once the asset database exists.",
      "type": "object",
      "required": ["path"],
      "properties": { "path": { "type": "string", "minLength": 1 }, "guid": { "type": "string" } },
      "additionalProperties": false
    },
    "Entity": {
      "type": "object",
      "required": ["id"],
      "properties": {
        "id": { "$ref": "#/$defs/EntityId" },
        "Name": { "$ref": "#/$defs/Name" },
        "Transform": { "$ref": "#/$defs/Transform" },
        "Parent": { "$ref": "#/$defs/Parent" },
        "Light": { "$ref": "#/$defs/Light" },
        "MeshSource": { "$ref": "#/$defs/MeshSource" },
        "MaterialOverride": { "$ref": "#/$defs/MaterialOverride" },
        "Camera": { "$ref": "#/$defs/Camera" },
        "Environment": { "$ref": "#/$defs/Environment" },
        "Spin": { "$ref": "#/$defs/Spin" }
      },
      "additionalProperties": { "type": "object" }
    },
    "LightType": {
      "description": "Light shape. Position and direction come from the entity's world transform; the direction is the entity's -Z axis.",
      "enum": ["Point", "Directional", "Spot", "AreaRect"]
    },
    "Name": {
      "description": "Display name for people and agents. Not unique; entities are identified by id.",
      "type": "object",
      "properties": {
        "value": { "description": "The name", "default": "", "allOf": [{ "type": "string" }] }
      },
      "additionalProperties": false
    },
    "Transform": {
      "description": "Local transform relative to the parent (or the world for a root entity). World matrix = parent world * T * R * S.",
      "type": "object",
      "properties": {
        "position": {
          "description": "Local translation",
          "default": [0, 0, 0],
          "allOf": [
            { "type": "array", "items": { "type": "number" }, "minItems": 3, "maxItems": 3 }
          ]
        },
        "rotation": {
          "description": "Local rotation as a unit quaternion, written [x, y, z, w]",
          "default": [0, 0, 0, 1],
          "allOf": [
            { "type": "array", "items": { "type": "number" }, "minItems": 4, "maxItems": 4 }
          ]
        },
        "scale": {
          "description": "Local scale per axis; a negative value mirrors",
          "default": [1, 1, 1],
          "allOf": [
            { "type": "array", "items": { "type": "number" }, "minItems": 3, "maxItems": 3 }
          ]
        }
      },
      "additionalProperties": false
    },
    "Parent": {
      "description": "Attaches the entity to a parent; its Transform is then relative to the parent. Cycles are rejected.",
      "type": "object",
      "properties": {
        "entity": {
          "description": "The parent entity's id; null makes the entity a root",
          "default": null,
          "allOf": [{ "anyOf": [{ "type": "null" }, { "$ref": "#/$defs/EntityId" }] }]
        }
      },
      "additionalProperties": false
    },
    "Light": {
      "description": "A light source. Position and direction come from the transform (direction = -Z).",
      "type": "object",
      "properties": {
        "type": {
          "description": "Light shape",
          "default": "Point",
          "allOf": [{ "$ref": "#/$defs/LightType" }]
        },
        "color": {
          "description": "Emitted color",
          "default": [1, 1, 1],
          "allOf": [
            {
              "type": "array",
              "items": { "type": "number", "minimum": 0 },
              "minItems": 3,
              "maxItems": 3
            }
          ]
        },
        "intensity": {
          "description": "Brightness multiplier on color",
          "default": 1,
          "allOf": [{ "type": "number", "minimum": 0 }]
        },
        "range": {
          "description": "Distance at which a Point/Spot light's contribution reaches zero",
          "default": 10,
          "allOf": [{ "type": "number", "minimum": 0 }]
        },
        "radius": {
          "description": "Emitter radius; larger values give softer shadows",
          "default": 0.1,
          "allOf": [{ "type": "number", "minimum": 0 }]
        },
        "innerConeDeg": {
          "description": "Spot: full-intensity cone angle",
          "default": 30,
          "allOf": [{ "type": "number", "minimum": 0, "maximum": 180 }]
        },
        "outerConeDeg": {
          "description": "Spot: cone angle where intensity reaches zero",
          "default": 45,
          "allOf": [{ "type": "number", "minimum": 0, "maximum": 180 }]
        },
        "areaEdge1": {
          "description": "AreaRect: first edge vector, local space",
          "default": [1, 0, 0],
          "allOf": [
            { "type": "array", "items": { "type": "number" }, "minItems": 3, "maxItems": 3 }
          ]
        },
        "areaEdge2": {
          "description": "AreaRect: second edge vector, local space",
          "default": [0, 0, 1],
          "allOf": [
            { "type": "array", "items": { "type": "number" }, "minItems": 3, "maxItems": 3 }
          ]
        }
      },
      "additionalProperties": false
    },
    "ModelAsset": {
      "description": "A model file (glb, gltf, fbx, obj, dae, blend, 3ds, ply) loaded through the asset resolver; its own materials are used.",
      "type": "object",
      "properties": {
        "asset": {
          "description": "Project-relative path of the model file, '/' separators",
          "default": { "path": "" },
          "allOf": [{ "$ref": "#/$defs/AssetRef" }]
        }
      },
      "additionalProperties": false
    },
    "SpherePrim": {
      "description": "A UV sphere around the origin.",
      "type": "object",
      "properties": {
        "radius": {
          "description": "Radius",
          "default": 0.5,
          "allOf": [{ "type": "number", "minimum": 0 }]
        },
        "sectors": {
          "description": "Segments around the equator",
          "default": 32,
          "allOf": [{ "type": "integer", "minimum": 3, "maximum": 1024 }]
        },
        "stacks": {
          "description": "Segments from pole to pole",
          "default": 16,
          "allOf": [{ "type": "integer", "minimum": 2, "maximum": 1024 }]
        }
      },
      "additionalProperties": false
    },
    "CubePrim": {
      "description": "A cube around the origin.",
      "type": "object",
      "properties": {
        "size": {
          "description": "Edge length",
          "default": 1,
          "allOf": [{ "type": "number", "minimum": 0 }]
        }
      },
      "additionalProperties": false
    },
    "PlatformPrim": {
      "description": "A flat box (a floor slab or platform) around the origin.",
      "type": "object",
      "properties": {
        "width": {
          "description": "Size along X",
          "default": 2,
          "allOf": [{ "type": "number", "minimum": 0 }]
        },
        "height": {
          "description": "Size along Y",
          "default": 0.4,
          "allOf": [{ "type": "number", "minimum": 0 }]
        },
        "depth": {
          "description": "Size along Z",
          "default": 2,
          "allOf": [{ "type": "number", "minimum": 0 }]
        }
      },
      "additionalProperties": false
    },
    "CylinderPrim": {
      "description": "A capped cylinder along Y, centered on the origin.",
      "type": "object",
      "properties": {
        "radius": {
          "description": "Radius",
          "default": 0.5,
          "allOf": [{ "type": "number", "minimum": 0 }]
        },
        "height": {
          "description": "Height along Y",
          "default": 1,
          "allOf": [{ "type": "number", "minimum": 0 }]
        },
        "segments": {
          "description": "Segments around the axis",
          "default": 16,
          "allOf": [{ "type": "integer", "minimum": 3, "maximum": 1024 }]
        }
      },
      "additionalProperties": false
    },
    "ConePrim": {
      "description": "A capped cone along Y, centered on the origin.",
      "type": "object",
      "properties": {
        "radius": {
          "description": "Base radius",
          "default": 0.5,
          "allOf": [{ "type": "number", "minimum": 0 }]
        },
        "height": {
          "description": "Height along Y",
          "default": 1,
          "allOf": [{ "type": "number", "minimum": 0 }]
        },
        "segments": {
          "description": "Segments around the axis",
          "default": 16,
          "allOf": [{ "type": "integer", "minimum": 3, "maximum": 1024 }]
        }
      },
      "additionalProperties": false
    },
    "QuadPrim": {
      "description": "One quad a-b-c-d (triangles a-b-c, a-c-d) with a flat normal and a vertex color.",
      "type": "object",
      "properties": {
        "a": {
          "description": "First corner",
          "default": [-0.5, -0.5, 0],
          "allOf": [
            { "type": "array", "items": { "type": "number" }, "minItems": 3, "maxItems": 3 }
          ]
        },
        "b": {
          "description": "Second corner",
          "default": [0.5, -0.5, 0],
          "allOf": [
            { "type": "array", "items": { "type": "number" }, "minItems": 3, "maxItems": 3 }
          ]
        },
        "c": {
          "description": "Third corner",
          "default": [0.5, 0.5, 0],
          "allOf": [
            { "type": "array", "items": { "type": "number" }, "minItems": 3, "maxItems": 3 }
          ]
        },
        "d": {
          "description": "Fourth corner",
          "default": [-0.5, 0.5, 0],
          "allOf": [
            { "type": "array", "items": { "type": "number" }, "minItems": 3, "maxItems": 3 }
          ]
        },
        "normal": {
          "description": "Normal of every vertex",
          "default": [0, 0, 1],
          "allOf": [
            { "type": "array", "items": { "type": "number" }, "minItems": 3, "maxItems": 3 }
          ]
        },
        "color": {
          "description": "Vertex color",
          "default": [1, 1, 1],
          "allOf": [
            {
              "type": "array",
              "items": { "type": "number", "minimum": 0 },
              "minItems": 3,
              "maxItems": 3
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "BoxPrim": {
      "description": "An axis-aligned box from lo to hi: 6 faces with flat normals and a vertex color.",
      "type": "object",
      "properties": {
        "lo": {
          "description": "Minimum corner",
          "default": [-0.5, -0.5, -0.5],
          "allOf": [
            { "type": "array", "items": { "type": "number" }, "minItems": 3, "maxItems": 3 }
          ]
        },
        "hi": {
          "description": "Maximum corner",
          "default": [0.5, 0.5, 0.5],
          "allOf": [
            { "type": "array", "items": { "type": "number" }, "minItems": 3, "maxItems": 3 }
          ]
        },
        "color": {
          "description": "Vertex color",
          "default": [1, 1, 1],
          "allOf": [
            {
              "type": "array",
              "items": { "type": "number", "minimum": 0 },
              "minItems": 3,
              "maxItems": 3
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "MeshSource": {
      "description": "Where the entity's mesh comes from: a model asset or a primitive. Instantiate builds the GPU mesh; entities with equal sources share one mesh.",
      "type": "object",
      "properties": {
        "source": {
          "description": "Exactly one of the alternatives, as {\"Name\": {...}}",
          "default": { "ModelAsset": { "asset": { "path": "" } } },
          "allOf": [
            {
              "oneOf": [
                {
                  "type": "object",
                  "properties": { "ModelAsset": { "$ref": "#/$defs/ModelAsset" } },
                  "required": ["ModelAsset"],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": { "SpherePrim": { "$ref": "#/$defs/SpherePrim" } },
                  "required": ["SpherePrim"],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": { "CubePrim": { "$ref": "#/$defs/CubePrim" } },
                  "required": ["CubePrim"],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": { "PlatformPrim": { "$ref": "#/$defs/PlatformPrim" } },
                  "required": ["PlatformPrim"],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": { "CylinderPrim": { "$ref": "#/$defs/CylinderPrim" } },
                  "required": ["CylinderPrim"],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": { "ConePrim": { "$ref": "#/$defs/ConePrim" } },
                  "required": ["ConePrim"],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": { "QuadPrim": { "$ref": "#/$defs/QuadPrim" } },
                  "required": ["QuadPrim"],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": { "BoxPrim": { "$ref": "#/$defs/BoxPrim" } },
                  "required": ["BoxPrim"],
                  "additionalProperties": false
                }
              ]
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "MaterialOverride": {
      "description": "The material of a mesh without its own materials (primitives). For a model with materials it only sets the legacy RT GI albedo.",
      "type": "object",
      "properties": {
        "baseColor": {
          "description": "Albedo",
          "default": [0.8, 0.8, 0.8],
          "allOf": [
            {
              "type": "array",
              "items": { "type": "number", "minimum": 0, "maximum": 1 },
              "minItems": 3,
              "maxItems": 3
            }
          ]
        },
        "roughness": {
          "description": "GGX roughness",
          "default": 0.5,
          "allOf": [{ "type": "number", "minimum": 0, "maximum": 1 }]
        },
        "metallic": {
          "description": "0 = dielectric, 1 = metal",
          "default": 0,
          "allOf": [{ "type": "number", "minimum": 0, "maximum": 1 }]
        },
        "emissiveStrength": {
          "description": "Emission multiplier",
          "default": 0,
          "allOf": [{ "type": "number", "minimum": 0 }]
        }
      },
      "additionalProperties": false
    },
    "Camera": {
      "description": "The scene camera (one per world). Its pose is the entity's world transform: it looks along -Z with +Y up; roll is ignored.",
      "type": "object",
      "properties": {
        "fovDeg": {
          "description": "Vertical field of view",
          "default": 45,
          "allOf": [{ "type": "number", "minimum": 1, "maximum": 179 }]
        },
        "nearPlane": {
          "description": "Near clip distance (raster passes)",
          "default": 0.1,
          "allOf": [{ "type": "number", "minimum": 1e-04 }]
        },
        "farPlane": {
          "description": "Far clip distance (raster passes); keep it above nearPlane",
          "default": 100,
          "allOf": [{ "type": "number", "minimum": 0.001 }]
        },
        "active": {
          "description": "false: the host keeps its own camera",
          "default": true,
          "allOf": [{ "type": "boolean" }]
        }
      },
      "additionalProperties": false
    },
    "Environment": {
      "description": "Image-based lighting (one per world): an equirectangular HDR image lighting and backing the scene.",
      "type": "object",
      "properties": {
        "hdri": {
          "description": "Project-relative path of the .hdr image; null for none",
          "default": null,
          "allOf": [{ "anyOf": [{ "type": "null" }, { "$ref": "#/$defs/AssetRef" }] }]
        },
        "intensity": {
          "description": "Multiplier on the image's radiance",
          "default": 1,
          "allOf": [{ "type": "number", "minimum": 0 }]
        }
      },
      "additionalProperties": false
    },
    "Spin": {
      "description": "Turns the entity about an axis of its own frame at a constant rate (the spin system, which runs before the transform system on every world update).",
      "type": "object",
      "properties": {
        "axis": {
          "description": "Rotation axis in the entity's local frame; any length (normalized), zero for no rotation",
          "default": [0, 1, 0],
          "allOf": [
            { "type": "array", "items": { "type": "number" }, "minItems": 3, "maxItems": 3 }
          ]
        },
        "degreesPerSecond": {
          "description": "Turn rate; negative turns the other way",
          "default": 90,
          "allOf": [{ "type": "number" }]
        }
      },
      "additionalProperties": false
    }
  }
}
