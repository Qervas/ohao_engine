    { "name": "FarCam", "camera": 1 },
    { "name": "OrthoCam", "camera": 2 }
  ],
  "cameras": [
    { "type": "perspective", "perspective": { "yfov": 1.2, "znear": 0.05, "zfar": 300 } },
    { "type": "perspective", "perspective": { "yfov": 0.9, "znear": 0.1 } },
    { "type": "orthographic", "orthographic": { "xmag": 1, "ymag": 1, "znear": 0.1, "zfar": 10 } }
  ],
