  "errors": [
    { "code": "E_IO", "meaning": "The file could not be read or written." },
    { "code": "E_PARSE", "meaning": "The text is not valid JSON (or not valid UTF-8)." },
    {
      "code": "E_FORMAT",
      "meaning": "Not an OHAO scene: \"format\" is missing or not \"ohao.scene\", or \"version\" or \"entities\" is missing."
    },
    {
      "code": "E_VERSION_UNSUPPORTED",
      "meaning": "The document version is not one this engine reads."
    },
    {
      "code": "E_COMPONENT_VERSION",
      "meaning": "A component's version in the file is newer than the engine's, or older with no upgrade path."
    },
    {
      "code": "E_UPGRADE",
      "meaning": "An upgrade (migration) rejected a component written by an older version."
    },
    {
      "code": "E_UNKNOWN_FIELD",
      "meaning": "A member the type does not have, or a runtime-only component in a file."
    },
    { "code": "E_DUPLICATE_KEY", "meaning": "The same member appears twice in one object." },
    { "code": "E_TYPE", "meaning": "A value of the wrong JSON type or shape." },
    { "code": "E_ENUM", "meaning": "A string that is not a value of the enum." },
    { "code": "E_RANGE", "meaning": "A number outside the field's limits or its type's range." },
    { "code": "E_NONFINITE", "meaning": "NaN or infinity, which a scene cannot contain." },
    {
      "code": "E_ID_INVALID",
      "meaning": "A missing, malformed or zero entity id (ids are 16 lowercase hex digits)."
    },
    { "code": "E_ID_DUPLICATE", "meaning": "Two entities with the same id." },
    { "code": "E_PARENT_MISSING", "meaning": "A Parent that names no entity in the document." },
    { "code": "E_PARENT_CYCLE", "meaning": "Parents that form a cycle." },
    {
      "code": "E_SINGLETON",
      "meaning": "A second instance of a component that allows one per world."
    },
    {
      "code": "E_ENTITY_NOT_FOUND",
      "meaning": "An entity reference that names no entity in the document."
    },
    { "code": "E_WORLD_NOT_EMPTY", "meaning": "Loading into a world that already has entities." },
    {
      "code": "E_TOO_MANY_ERRORS",
      "meaning": "More errors exist than are reported (the first 100 are)."
    },
    { "code": "E_METHOD", "meaning": "An unknown API method." },
    {
      "code": "E_COMMAND",
      "meaning": "A request that is malformed or cannot apply (unknown op, missing member, absent component)."
    },
    {
      "code": "E_COMPONENT_UNKNOWN",
      "meaning": "A request names a type that is not a component (or, for edits, not a saved one)."
    },
    {
      "code": "E_PATH",
      "meaning": "A path that reaches no field: \"/Type/field\", then optionally member names or array indices."
    },
    { "code": "E_SNAPSHOT_UNKNOWN", "meaning": "No snapshot has this name (world.restore)." },
    {
      "code": "E_ASSET_NOT_FOUND",
      "meaning": "An asset path that names no file in the project (or leaves the project)."
    },
    {
      "code": "E_ASSET_INVALID",
      "meaning": "An asset file that exists but cannot be loaded (format or content)."
    },
    {
      "code": "E_MESH_INVALID",
      "meaning": "A MeshSource that gives no usable geometry (InstantiateError)."
    },
    {
      "code": "E_RENDER",
      "meaning": "render.capture failed: no usable GPU, a frame that failed, or an image that could not be written."
    },
    {
      "code": "E_INTERNAL",
      "meaning": "An internal error in a tool (a bug); the operation did not complete (ohao exits with 3)."
    },
    {
      "code": "E_ACCESS",
      "meaning": "A path outside the server's sandbox: absolute, with '..', or a write outside the output directory."
    },
    { "code": "E_STATE", "meaning": "A method not allowed in the current time mode or host." },
    {
      "code": "E_REPLAY",
      "meaning": "An input recording that does not match the world it is replayed on."
    },
    {
      "code": "E_LEVEL_NODE",
      "meaning": "A level node whose transform is not translation, rotation and scale (shear or perspective)."
    },
    {
      "code": "E_LEVEL_UNSUPPORTED",
      "meaning": "A level file that needs an extension OHAO does not read (Draco or meshopt compression)."
    },
    {
      "code": "E_LEVEL_EXTRAS",
      "meaning": "A level node's extras with a bad hint value or an unknown capitalised key (a misspelt component); the node loads without it."
    },
    {
      "code": "W_UNKNOWN_COMPONENT",
      "meaning": "Warning: an unknown component close to a known name. It is kept, but may be a typo."
    },
    {
      "code": "W_UNSAVEABLE_MESH",
      "meaning": "Warning: an entity renders a mesh with no MeshSource (made in code); it is saved without it."
    },
    {
      "code": "W_LEVEL_EXTRAS",
      "meaning": "Warning: an unknown lower-case key in a level node's extras (another tool's property); ignored."
    },
    {
      "code": "W_LEVEL_UNSUPPORTED",
      "meaning": "Warning: level content OHAO ignores (skins, animations, morph targets, KHR_materials_*, orthographic cameras)."
    },
    {
      "code": "W_LEVEL_DYNAMIC_MESH",
      "meaning": "Warning: a dynamic body's mesh collider; it is built as the mesh's convex hull, since triangle meshes do not simulate."
    },
    {
      "code": "W_COLLIDER_NO_MESH",
      "meaning": "Warning: a collider with no size on an entity whose mesh is missing or did not load; it gets no collider."
    },
    {
      "code": "W_COLLIDER_SCALE",
      "meaning": "Warning: a sphere or capsule collider under a scale whose axes differ by more than 1%; it takes the largest axis."
    },
    {
      "code": "E_NOT_FOUND",
      "meaning": "What a method was asked about is not there: no level in the world, or an entity that is not a level (level.info, level.reload)."
    },
    {
      "code": "E_PARAMS",
      "meaning": "Params that pass their schema but break a rule of the method: physics.raycast's zero direction, or max outside (0, 100000]."
    },
    {
      "code": "W_LEVEL_NO_PLAYER_SPAWN",
      "meaning": "Warning: a level without a \"player\" spawn (level.info). Not an error: a prop kit has none."
    },
    {
      "code": "W_PHYSICS_PARENT_SCALE",
      "meaning": "Warning: a dynamic body under a parent scaled unevenly; the pose physics writes back to its Transform is approximate (physics.info)."
    }
  ],
