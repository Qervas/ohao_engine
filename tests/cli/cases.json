{
  "_comment": [
    "CLI goldens (reflection spec, tests 14 and 16). Run from the repo root:",
    "  python tests/cli/check_cli.py            # every case, twice each",
    "  python tests/cli/check_cli.py --cpu-only # skip the cases that create a Vulkan device",
    "  python tests/cli/check_cli.py --update   # rewrite tests/cli/expected (look at the diff first)",
    "Each case runs twice from a fresh build/cli_tmp. Both runs must print the same bytes and",
    "write the same files, and exit with `exit`. With `stdout`, the output must equal",
    "tests/cli/expected/<name>.out. `files` maps a written file to the checked-in file it must",
    "equal byte for byte; `outputs` lists written files only checked across the two runs.",
    "`timed` cases print wall times (render.capture's ms), so their stdout is not compared;",
    "`contains` lists strings both runs must print instead. `env` adds environment variables.",
    "Exit codes: 0 ok, 1 validation/usage/input, 2 asset or instantiate, 3 GPU or internal."
  ],
  "cases": [
    {"name": "schema", "argv": ["ohao", "schema", "-o", "build/cli_tmp/schema"], "exit": 0, "stdout": true,
     "outputs": ["build/cli_tmp/schema/ohao_schema.json", "build/cli_tmp/schema/scene.schema.json"]},
    {"name": "validate_ok", "argv": ["ohao", "validate", "assets/scenes/damaged_helmet.scene.json", "--check-assets"],
     "exit": 0, "stdout": true},
    {"name": "validate_invalid", "argv": ["ohao", "validate", "tests/scenes/invalid/06_agent_mistakes.scene.json"],
     "exit": 1, "stdout": true},
    {"name": "validate_missing_asset",
     "argv": ["ohao", "validate", "tests/cli/scenes/missing_asset.scene.json", "--check-assets"], "exit": 2, "stdout": true},
    {"name": "fmt_check_canonical", "argv": ["ohao", "fmt", "assets/scenes/cornell_box.scene.json", "--check"],
     "exit": 0, "stdout": true},
    {"name": "fmt_check_not_canonical", "argv": ["ohao", "fmt", "tests/cli/scenes/not_canonical.scene.json", "--check"],
     "exit": 1, "stdout": true},
    {"name": "fmt_rewrite",
     "argv": ["ohao", "fmt", "tests/cli/scenes/not_canonical.scene.json", "-o", "build/cli_tmp/canonical.scene.json"],
     "exit": 0, "stdout": true, "files": {"build/cli_tmp/canonical.scene.json": "tests/cli/expected/fmt_rewrite.scene.json"}},
    {"name": "fmt_compact_round_trip",
     "argv": ["ohao", "fmt", "assets/scenes/cornell_box.scene.json", "--compact", "-o", "build/cli_tmp/cornell.compact.json"],
     "exit": 0, "stdout": true, "outputs": ["build/cli_tmp/cornell.compact.json"]},
    {"name": "fmt_compact_back",
     "_note": "Runs after fmt_compact_round_trip (same build/cli_tmp): compact -> pretty gives the checked-in file back.",
     "argv": ["ohao", "fmt", "build/cli_tmp/cornell.compact.json", "-o", "build/cli_tmp/cornell.pretty.json"],
     "exit": 0, "stdout": true, "files": {"build/cli_tmp/cornell.pretty.json": "assets/scenes/cornell_box.scene.json"}},
    {"name": "apply",
     "argv": ["ohao", "apply", "assets/scenes/cornell_box.scene.json", "tests/cli/scripts/move_sphere.commands.json",
              "-o", "build/cli_tmp/moved.scene.json"],
     "exit": 0, "stdout": true, "files": {"build/cli_tmp/moved.scene.json": "tests/cli/expected/apply.scene.json"}},
    {"name": "query",
     "argv": ["ohao", "query", "assets/scenes/cornell_box.scene.json", "--name-contains", "Sphere",
              "--fields", "/Transform,/MaterialOverride/roughness"],
     "exit": 0, "stdout": true},
    {"name": "query_bad_field",
     "argv": ["ohao", "query", "assets/scenes/cornell_box.scene.json", "--fields", "/Transform/positon"],
     "exit": 1, "stdout": true},
    {"name": "summary", "argv": ["ohao", "summary", "assets/scenes/damaged_helmet.scene.json", "--max-nodes", "12"],
     "exit": 0, "stdout": true},
    {"name": "run_steps",
     "argv": ["ohao", "run", "assets/scenes/cornell_box.scene.json", "--steps", "30", "--dt", "0.02",
              "--save", "build/cli_tmp/stepped.scene.json"],
     "exit": 0, "stdout": true, "files": {"build/cli_tmp/stepped.scene.json": "assets/scenes/cornell_box.scene.json"}},
    {"name": "run_script",
     "_note": "snapshot, apply, step, query, restore, query, save: the restored world saves as the file it came from.",
     "argv": ["ohao", "run", "assets/scenes/cornell_box.scene.json", "--seed", "0000000000000007",
              "--script", "tests/cli/scripts/edit_restore.jsonl"],
     "exit": 0, "stdout": true,
     "files": {"build/cli_tmp/edit_restore.scene.json": "assets/scenes/cornell_box.scene.json"}},
    {"name": "run_script_mistakes",
     "argv": ["ohao", "run", "assets/scenes/cornell_box.scene.json", "--script", "tests/cli/scripts/mistakes.jsonl"],
     "exit": 1, "stdout": true},
    {"name": "run_missing_scene", "argv": ["ohao", "run", "tests/cli/scenes/no_such.scene.json"], "exit": 1, "stdout": true},
    {"name": "usage_unknown_command", "argv": ["ohao", "frobnicate"], "exit": 1, "stdout": true},
    {"name": "usage_render_option_without_render",
     "argv": ["ohao", "run", "assets/scenes/cornell_box.scene.json", "--mode", "deferred"], "exit": 1, "stdout": true},
    {"name": "usage_bad_exposure",
     "argv": ["ohao", "run", "assets/scenes/cornell_box.scene.json", "--render", "build/cli_tmp/x.png", "--exposure", "bright"],
     "exit": 1, "stdout": true},
    {"name": "render_bad_size",
     "argv": ["ohao", "run", "assets/scenes/cornell_box.scene.json", "--render", "build/cli_tmp/x.png", "--size", "8x8"],
     "exit": 1, "stdout": true},
    {"name": "render_unwritable", "gpu": true,
     "argv": ["ohao", "run", "assets/scenes/cornell_box.scene.json", "--render", "build/cli_tmp/no/such/dir/x.png",
              "--size", "320x180"],
     "exit": 3, "stdout": true},
    {"name": "render_missing_asset", "gpu": true,
     "argv": ["ohao", "run", "tests/cli/scenes/missing_asset.scene.json", "--render", "build/cli_tmp/ghost.png",
              "--size", "64x64"],
     "exit": 2, "stdout": true},
    {"name": "validation_cornell_deferred", "gpu": true, "timed": true,
     "_note": "Test 18: a deferred render under the validation layers reports zero messages.",
     "env": {"OHAO_VALIDATION": "1"},
     "argv": ["ohao", "run", "assets/scenes/cornell_box.scene.json", "--render", "build/cli_tmp/cornell.png",
              "--mode", "deferred"],
     "exit": 0, "contains": ["\"frames\":10", "\"validation\":0}"]},
    {"name": "validation_helmet_deferred", "gpu": true, "timed": true,
     "_note": "Test 18, the helmet room with model_viewer's post effects.",
     "env": {"OHAO_VALIDATION": "1"},
     "argv": ["ohao", "run", "assets/scenes/damaged_helmet.scene.json", "--render", "build/cli_tmp/helmet.png",
              "--mode", "deferred", "--frames", "30", "--post", "taa,ssao,bloom", "--exposure", "1"],
     "exit": 0, "contains": ["\"frames\":30", "\"validation\":0}"]},
    {"name": "cornell_box_save_scene",
     "_note": "Test 16: the code-built world saves as the checked-in file.",
     "argv": ["cornell_box", "--save-scene", "build/cli_tmp/cornell_box.scene.json"], "exit": 0,
     "files": {"build/cli_tmp/cornell_box.scene.json": "assets/scenes/cornell_box.scene.json"}},
    {"name": "model_viewer_save_scene",
     "_note": "Test 16, the helmet room.",
     "argv": ["model_viewer", "assets/test_models/DamagedHelmet.glb", "--save-scene",
              "build/cli_tmp/damaged_helmet.scene.json"], "exit": 0,
     "files": {"build/cli_tmp/damaged_helmet.scene.json": "assets/scenes/damaged_helmet.scene.json"}}
  ]
}
