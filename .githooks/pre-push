#!/bin/sh
# Light CI on this machine, 2 of 2 (AGENTS.md, "Light CI"): nothing leaves the machine without the whole check
# (tools/check.py: build, ohao doctor, every gate; about 10 s). A failure blocks the push.
# On once per clone: git config core.hooksPath .githooks
root=$(git rev-parse --show-toplevel) || exit 1
for py in "$root/.venv/bin/python" "$root/.venv/Scripts/python.exe"; do
    if [ -x "$py" ]; then exec "$py" "$root/tools/check.py"; fi
done
if command -v python3 >/dev/null 2>&1; then exec python3 "$root/tools/check.py"; fi
exec python "$root/tools/check.py"
